# OS
.DS_Store

# Data - datasets can be large and shouldn't live in git history.
# Keep the folder structure (.gitkeep) but not the actual files.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts (can be large / regenerable)
ml-service/models/*.pkl
ml-service/models/*.joblib
ml-service/models/*.h5
